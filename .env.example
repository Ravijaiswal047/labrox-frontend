# ==============================================================================
# LabRox Enterprise LIMS (labrox-frontend) - Web Client Environment Baseline
# ==============================================================================

# Application Runtime Environment (development | staging | production)
VITE_APP_ENVIRONMENT=production

# Base URL of LabRox API Gateway (Spring Cloud Gateway)
VITE_APP_REACT_APP_BASE_URL=http://localhost:8088

# API Prefix
VITE_API_PREFIX=/elabpro/api

# Application Metadata
VITE_APP_VERSION=0.1.0
VITE_DATE_FORMAT=DD/MM/YYYY

# Optional OAuth Client ID (Safe public client identifier)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional Third-Party Integrations
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

