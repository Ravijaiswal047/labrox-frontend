    "bootstrap-icons": "^1.11.3",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.8",
    "ckeditor4": "4.22.1",
    "ckeditor4-react": "^3.1.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.19",
    "events": "^3.3.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
