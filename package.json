    "nepali-date": "^0.1.3",
    "oidc-client-ts": "3.1.0",
    "pdf-lib": "^1.17.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.2",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
