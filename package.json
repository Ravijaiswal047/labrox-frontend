{
  "name": "labrox-frontend",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "node --insecure-http-parser ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=14336 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "format": "prettier-eslint $PWD/'src/**/*.{js,json,jsx}' --write",
    "lint": "eslint src/**/*.js",
    "store-version": "echo '{\"version\" : '$(cat package.json | jq .version )'}' > public/version.json && git add public/version.json && git commit -m \"version upgrade \"",
    "release:patch": "standard-version --release-as patch && npm run store-version",
    "release:minor": "standard-version --release-as minor && npm run store-version",
    "release:major": "standard-version --release-as major && npm run store-version",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.cjs",
    "i18n:compile": "i18next-resources-to-ts -i ./public/locales -o ./src/i18n/resources.d.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-react"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.0.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.10",
    "@mui/system": "^9.5.0",
    "@mui/x-charts": "^9.0.4",
    "@profabric/react-components": "0.2.4",
    "@react-google-maps/api": "^2.20.7",
    "@react-oauth/google": "^0.13.4",
    "@reduxjs/toolkit": "2.6.0",
